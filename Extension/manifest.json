{
  "manifest_version": 3,
  "name": "Daybook Video",
  "version": "0.1.0",
  "description": "Counts actual video playback locally in Daybook, including background tabs and embedded players.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["playback-core.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Daybook Video setup"
  }
}
